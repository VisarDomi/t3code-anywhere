#!/bin/sh
# Keeps a fixed Wi-Fi address only on the home network; plain DHCP everywhere else.
#
# macOS sets addresses per network service, not per Wi-Fi network: a laptop given a
# fixed address at home ("Manually" or "DHCP with manual address") keeps it on every
# other network and is offline there. Home is recognised by the Wi-Fi gateway's MAC
# address, so a foreign network that reuses the same router address stays on DHCP.
# Runs as root every 10 s (LaunchDaemon local.wifi-home-address); settings come from
# /usr/local/etc/wifi-home-address.conf, written by macos/install.sh --wifi-home-address:
#   SERVICE=Wi-Fi IFACE=en0 HOME_IP=192.168.1.50 ROUTER=192.168.1.1 ROUTER_MAC=aa:b:cc:dd:e:ff
# (ROUTER_MAC as `arp` prints it, without leading zeros.)

conf=/usr/local/etc/wifi-home-address.conf
[ -r "$conf" ] || exit 0
. "$conf"
GRACE=30                                # seconds away from home before switching to DHCP
MISS=/var/run/wifi-home-address.miss

log() { logger -t wifi-home-address "$*"; }

ifconfig "$IFACE" 2>/dev/null | grep -q 'status: active' || { rm -f "$MISS"; exit 0; }

mode=$(networksetup -getinfo "$SERVICE" | head -1)
ping -c 1 -t 1 -b "$IFACE" "$ROUTER" >/dev/null 2>&1   # refresh the ARP entry over Wi-Fi
mac=$(arp -n -i "$IFACE" "$ROUTER" 2>/dev/null | awk '$3 == "at" {print $4}')

if [ "$mac" = "$ROUTER_MAC" ]; then
    rm -f "$MISS"
    case "$mode" in
        Manual*) ;;
        *) networksetup -setmanualwithdhcprouter "$SERVICE" "$HOME_IP" &&
               log "home network: Wi-Fi fixed at $HOME_IP" ;;
    esac
    exit 0
fi

case "$mode" in
    Manual*)
        now=$(date +%s)
        [ -f "$MISS" ] || echo "$now" > "$MISS"
        if [ $((now - $(cat "$MISS"))) -ge "$GRACE" ]; then
            networksetup -setdhcp "$SERVICE" && log "away from home: Wi-Fi on DHCP"
            rm -f "$MISS"
        fi
        ;;
    *) rm -f "$MISS" ;;
esac
