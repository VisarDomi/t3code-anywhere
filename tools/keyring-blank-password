#!/usr/bin/env python3
"""Removes the password from the GNOME default keyring, so it opens without a prompt.

On a Linux desktop that logs in automatically (no password typed at login), nothing
unlocks the keyring, and the first app that reads a stored key after login asks for its
password: T3 Code keeps its encryption key there (as do Chromium-based apps). Without a
password the keyring file in ~/.local/share/keyrings is plain text: only do this where
the disk, or the machine, is already protected. Run once in a terminal; it asks for the
keyring's current password:
    python3 tools/keyring-blank-password
"""
import getpass
import sys

from gi.repository import Gio, GLib

SERVICE = "/org/freedesktop/secrets"
bus = Gio.bus_get_sync(Gio.BusType.SESSION)


def call(path, interface, method, args, reply=None):
    return bus.call_sync("org.freedesktop.secrets", path, interface, method, args,
                         GLib.VariantType(reply) if reply else None,
                         Gio.DBusCallFlags.NONE, -1, None)


keyring = call(SERVICE, "org.freedesktop.Secret.Service", "ReadAlias",
               GLib.Variant("(s)", ("default",)), "(o)").unpack()[0]
_, session = call(SERVICE, "org.freedesktop.Secret.Service", "OpenSession",
                  GLib.Variant("(sv)", ("plain", GLib.Variant("s", ""))), "(vo)").unpack()


def secret(value):
    return (session, b"", value.encode(), "text/plain")


name = call(keyring, "org.freedesktop.DBus.Properties", "Get",
            GLib.Variant("(ss)", ("org.freedesktop.Secret.Collection", "Label")), "(v)").unpack()[0]
current = getpass.getpass(f"Current password of the '{name}' keyring: ")
try:
    # gnome-keyring's own API for changing a password without its GUI prompt.
    call(SERVICE, "org.gnome.keyring.InternalUnsupportedGuiltRiddenInterface",
         "ChangeWithMasterPassword",
         GLib.Variant("(o(oayays)(oayays))", (keyring, secret(current), secret(""))))
except GLib.Error as error:
    sys.exit(f"Not changed: {error.message.rsplit(':', 1)[-1].strip()}")
print("Done: the keyring no longer asks for a password.")
